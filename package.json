{
  "name": "yuanbao-swarm-search-mcp",
  "version": "1.0.0",
  "description": "腾讯元宝搜索（Tencent Yuanbao Search / wsa SearchPro）+ 群智能体迭代搜索 的动态 MCP 插件。基于 planner→searcher swarm→gap analyst→synthesizer 的多轮迭代深搜架构，支持运行时动态注册/启停工具与 Swarm Profile。",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yuanbao-swarm-search-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "start:web": "node dist/web/server.js",
    "smoke": "node test/smoke.mjs",
    "test": "npm run smoke && node test/regression-core.mjs && node test/regression.mjs && node test/web.mjs",
    "dev": "vite",
    "dev:server": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "mcp",
    "tencent",
    "yuanbao",
    "wsa",
    "search",
    "swarm",
    "multi-agent",
    "iterative-search",
    "deep-research"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^18.0.9",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}
