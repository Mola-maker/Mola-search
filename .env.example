# 腾讯云凭证（在 https://console.cloud.tencent.com/cam/capi 获取；需开通元宝搜索 wsa 调用权限）
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx

# 可选
# YUANBAO_ENDPOINT=https://wsa.tencentcloudapi.com
# YUANBAO_QPS=5
# YUANBAO_TIMEOUT_MS=15000
# YUANBAO_MAX_RETRIES=2
# YUANBAO_DATA_DIR=./.yuanbao-swarm-data
# 干跑模式：1=不发网络请求、不需要密钥（夹具数据，用于联调）
# YUANBAO_DRY_RUN=1
