# 本仓库有两个子系统，各自读各自的键：
#   A. 元宝群智能体 MCP 插件（根目录 src/、web/、dist/，Node/TypeScript）
#   B. MolaSearch 检索工作台（magpie/ 内的 Go 程序）
# 复制本文件为 .env（放在项目根或可执行文件旁），或直接设成系统环境变量。
# 全部可留空：留空的通道会明确显示“未配置”，不会伪造结果。

# ============================================================
# A. 元宝群智能体 MCP 插件
# ============================================================
# 腾讯云凭证（在 https://console.cloud.tencent.com/cam/capi 获取；需开通元宝搜索 wsa 调用权限）
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx

# 可选
# YUANBAO_ENDPOINT=https://wsa.tencentcloudapi.com
# YUANBAO_QPS=5
# YUANBAO_TIMEOUT_MS=15000
# YUANBAO_MAX_RETRIES=2
# YUANBAO_DATA_DIR=./.yuanbao-swarm-data
# 干跑模式：1=不发网络请求、不需要密钥（夹具数据，用于联调）
# YUANBAO_DRY_RUN=1

# ============================================================
# B. MolaSearch 检索工作台
# ============================================================
# 全部可留空：留空时免 Key 多源通道（Bing / DuckDuckGo / Wikipedia /
# 百度百科 / GitHub / Bilibili / ArXiv / You.com 免费搜索）照常工作。

# 腾讯云搜索 API（WSA SearchPro，TC3 签名；两者成对；可选 Provider 之一）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 元宝官方 MCP 端点（api.wsa.cloud.tencent.com/Mcp）的 Bearer。它是 WSA
# API Key，不是 SecretId/SecretKey：用后者调用会返回 UnauthorizedOperation。
# 留空时只走 TC3 签名接口。
TENCENT_WSA_API_KEY=
# 可选：WSA API 版本。默认 2025-05-08 —— 实测 2025-05-22 返回 InvalidAction。
# TENCENT_WSA_VERSION=

# 高德开放平台（地理编码 + 实时气象）；留空时走 Nominatim + Open-Meteo
AMAP_KEY=

# 可选增强的搜索 API（也可在 magpie 的 Providers → Search APIs 里配置）
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
DEEPSEEK_API_KEY=
# 自建 SearXNG
SEARXNG_URL=
SEARXNG_API_KEY=
# GitHub PAT（获取：github.com/settings/tokens）。⚠️ 代码尚未接入（规划中，
# 见 proposals/30模式算法实现与搜索插件集成.md §三）：接入前 githubChannel
# 以匿名 60 req/h 运行；接入后 PAT 为 5000 req/h。
# GITHUB_TOKEN=

# 远程 Embedding（OpenAI 兼容 /v1/embeddings）；留空时用本地 1024 维
# N-Gram 特征哈希嵌入，不联网、确定性、可计算真实余弦相似度。
MOLA_EMBED_API_BASE=
MOLA_EMBED_API_KEY=
MOLA_EMBED_MODEL=Qwen3-Embedding-8B

# 远程视觉模型（OpenAI 兼容 /v1/chat/completions），用于 M22/M26 图片描述
# 发送前会重编码图片，EXIF/GPS 不会离开本机。
MOLA_VISION_API_BASE=
MOLA_VISION_API_KEY=
MOLA_VISION_MODEL=gpt-4o-mini

# 远程 Reranker（Jina / Cohere 兼容 POST /rerank）；留空时保持 RRF(k=60) 顺序。
MOLA_RERANK_API_BASE=
MOLA_RERANK_API_KEY=
MOLA_RERANK_MODEL=

# 合规红线词表：一行一词，# 开头为注释。设置后整份词表以文件为准；
# 文件读不到或为空时拒绝检索（fail closed）。留空使用内置列表。
# MOLA_COMPLIANCE_FILE=

# `magpie web`（3430）的登录 key；≥16 位字母/数字/-._~
# MAGPIE_WEB_KEY=

# 数据目录（默认：可执行文件旁的 data/）
# MOLASEARCH_DATA=
